{
  "manifest_version": 3,
  "name": "JobHunt Capture",
  "version": "1.4.0",
  "description": "Capture job postings into the local jobhunt tracker.",
  "homepage_url": "https://jobhunt-app.com",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*",
    "https://boards-api.greenhouse.io/*",
    "https://api.lever.co/*",
    "https://api.ashbyhq.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "service_worker.js"
    ]
  },
  "action": {
    "default_title": "Capture job",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "capture-job": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Capture the current job posting"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jobhunt-capture@jobhunt-app.com",
      "strict_min_version": "128.0"
    }
  }
}
