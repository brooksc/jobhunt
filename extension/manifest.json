{
  "manifest_version": 3,
  "name": "JobHunt Capture",
  "version": "1.0.4",
  "description": "Capture job postings into the local jobhunt tracker.",
  "homepage_url": "https://jobhunt-app.com",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Capture job",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "key": ""
}
